<?xml version="1.0" encoding="UTF-8"?>
<!--
  rutas.xsd — XML Schema Definition para rutas.xml
  Proyecto: Turismo en La Coruña | UO301366
  Asignatura: Software y Estándares para la Web 2025/2026

  Generado a partir de rutas.dtd.
  Amplía el DTD con validación estricta de tipos de datos:
    - fechaInicio  → xs:date    (formato YYYY-MM-DD)
    - horaInicio   → xs:time    (formato HH:MM:SS)
    - longitud     → xs:decimal (grados decimales, rango -180 a 180)
    - latitud      → xs:decimal (grados decimales, rango -90 a 90)
    - altitud      → xs:integer (metros, valor ≥ 0)
    - recomendacion → xs:integer (rango 0 a 10)
    - referencia   → xs:anyURI  (URL válida)
    - distanciaDesdeAnterior → xs:decimal (valor ≥ 0)
    - atributo unidades → enumeración restringida a "m" o "km"
    - atributo opcional  → enumeración restringida a "si" o "no"
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified">

  <!-- ===========================================================
       TIPOS SIMPLES REUTILIZABLES (restricciones de tipos base)
       =========================================================== -->

  <!-- Puntuación de recomendación: entero entre 0 y 10 -->
  <xs:simpleType name="tipoPuntuacion">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Longitud geográfica: decimal entre -180 y 180 -->
  <xs:simpleType name="tipoLongitud">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-180"/>
      <xs:maxInclusive value="180"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Latitud geográfica: decimal entre -90 y 90 -->
  <xs:simpleType name="tipoLatitud">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="-90"/>
      <xs:maxInclusive value="90"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Altitud: entero no negativo (metros sobre el nivel del mar) -->
  <xs:simpleType name="tipoAltitud">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Distancia: decimal no negativo -->
  <xs:simpleType name="tipoDistancia">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Unidades de distancia: enumeración restringida -->
  <xs:simpleType name="tipoUnidades">
    <xs:restriction base="xs:string">
      <xs:enumeration value="m"/>
      <xs:enumeration value="km"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Atributo opcional: enumeración restringida -->
  <xs:simpleType name="tipoOpcional">
    <xs:restriction base="xs:string">
      <xs:enumeration value="si"/>
      <xs:enumeration value="no"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Nombre de archivo: cadena no vacía -->
  <xs:simpleType name="tipoNombreArchivo">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===========================================================
       TIPOS COMPLEJOS REUTILIZABLES
       =========================================================== -->

  <!-- Tipo para coordenadas geográficas (longitud, latitud, altitud) -->
  <xs:complexType name="tipoCoordenadas">
    <xs:sequence>
      <xs:element name="longitud" type="tipoLongitud"/>
      <xs:element name="latitud"  type="tipoLatitud"/>
      <xs:element name="altitud"  type="tipoAltitud"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===========================================================
       ELEMENTO RAÍZ: <rutas>
       =========================================================== -->

  <xs:element name="rutas">
    <xs:complexType>
      <xs:sequence>
        <!-- Una o más rutas turísticas -->
        <xs:element name="ruta" type="tipoRuta" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <!-- Atributo provincia: texto obligatorio -->
      <xs:attribute name="provincia" type="xs:string" use="required"/>
    </xs:complexType>

    <!-- Restricción de unicidad: el atributo id de cada <ruta> debe ser único -->
    <xs:unique name="unicidadIdRuta">
      <xs:selector xpath="ruta"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>

  <!-- ===========================================================
       TIPO COMPLEJO: tipoRuta
       =========================================================== -->

  <xs:complexType name="tipoRuta">
    <xs:sequence>
      <xs:element name="nombre"            type="xs:string"/>
      <xs:element name="tipo"              type="xs:string"/>
      <xs:element name="transporte"        type="xs:string"/>
      <!-- fechaInicio es OPCIONAL: minOccurs="0" -->
      <xs:element name="fechaInicio"       minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:date">
              <xs:attribute name="opcional" type="tipoOpcional" default="si"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <!-- horaInicio es OPCIONAL: minOccurs="0" -->
      <xs:element name="horaInicio"        minOccurs="0" maxOccurs="1">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <!-- Se permite HH:MM además de HH:MM:SS, por ello xs:string con patrón -->
              <xs:attribute name="opcional" type="tipoOpcional" default="si"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
      <xs:element name="duracion"          type="xs:string"/>
      <xs:element name="agencia"           type="xs:string"/>
      <xs:element name="descripcion"       type="xs:string"/>
      <xs:element name="personas"          type="xs:string"/>
      <xs:element name="lugarInicio"       type="xs:string"/>
      <xs:element name="direccionInicio"   type="xs:string"/>
      <xs:element name="coordenadasInicio" type="tipoCoordenadas"/>
      <xs:element name="referencias"       type="tipoReferencias"/>
      <xs:element name="recomendacion"     type="tipoPuntuacion"/>
      <xs:element name="planimetria"       type="tipoPlanimetria"/>
      <xs:element name="altimetria"        type="tipoAltimetria"/>
      <xs:element name="hitos"             type="tipoHitos"/>
    </xs:sequence>
    <!-- id: identificador único de tipo ID (validado por el parser XML) -->
    <xs:attribute name="id" type="xs:ID" use="required"/>
  </xs:complexType>

  <!-- ===========================================================
       TIPO COMPLEJO: tipoReferencias
       =========================================================== -->

  <xs:complexType name="tipoReferencias">
    <xs:sequence>
      <!-- Mínimo 3 referencias (dos fijas + una o más adicionales) -->
      <xs:element name="referencia" type="xs:anyURI" minOccurs="3" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===========================================================
       TIPOS COMPLEJOS: tipoPlanimetria / tipoAltimetria
       =========================================================== -->

  <!-- Elemento vacío con atributo archivo obligatorio -->
  <xs:complexType name="tipoPlanimetria">
    <xs:attribute name="archivo" type="tipoNombreArchivo" use="required"/>
  </xs:complexType>

  <xs:complexType name="tipoAltimetria">
    <xs:attribute name="archivo" type="tipoNombreArchivo" use="required"/>
  </xs:complexType>

  <!-- ===========================================================
       TIPO COMPLEJO: tipoHitos
       =========================================================== -->

  <xs:complexType name="tipoHitos">
    <xs:sequence>
      <!-- Mínimo 5 hitos por ruta -->
      <xs:element name="hito" type="tipoHito" minOccurs="5" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===========================================================
       TIPO COMPLEJO: tipoHito
       =========================================================== -->

  <xs:complexType name="tipoHito">
    <xs:sequence>
      <xs:element name="nombre"      type="xs:string"/>
      <xs:element name="descripcion" type="xs:string"/>
      <xs:element name="coordenadas" type="tipoCoordenadas"/>
      <xs:element name="distanciaDesdeAnterior" type="tipoDistanciaDesdeAnterior"/>
      <xs:element name="fotos"       type="tipoFotos"/>
      <!-- videos es OPCIONAL: minOccurs="0" -->
      <xs:element name="videos"      type="tipoVideos" minOccurs="0" maxOccurs="1"/>
    </xs:sequence>
    <!-- orden: número entero positivo que indica el orden del hito en la ruta -->
    <xs:attribute name="orden" type="xs:positiveInteger" use="required"/>
  </xs:complexType>

  <!-- ===========================================================
       TIPO COMPLEJO: tipoDistanciaDesdeAnterior
       =========================================================== -->

  <xs:complexType name="tipoDistanciaDesdeAnterior">
    <xs:simpleContent>
      <xs:extension base="tipoDistancia">
        <!-- unidades: enumeración restringida a "m" o "km" -->
        <xs:attribute name="unidades" type="tipoUnidades" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ===========================================================
       TIPOS COMPLEJOS: tipoFotos / tipoVideos
       =========================================================== -->

  <!-- Galería de fotos: mínimo 1, máximo 5 -->
  <xs:complexType name="tipoFotos">
    <xs:sequence>
      <xs:element name="foto" type="tipoNombreArchivo" minOccurs="1" maxOccurs="5"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Galería de vídeos: mínimo 1, máximo 3 (el elemento padre es opcional) -->
  <xs:complexType name="tipoVideos">
    <xs:sequence>
      <xs:element name="video" type="tipoNombreArchivo" minOccurs="1" maxOccurs="3"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
